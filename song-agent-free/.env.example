# Local ACE-Step server; run ACE-Step separately
ACE_STEP_API_URL=http://127.0.0.1:8001
ACE_STEP_API_KEY=

# Optional token for the local agent API. Replace with a long random value.
APP_TOKEN=change-this-to-a-long-random-secret

# Target: at most 50 queued jobs per UTC day
DAILY_TARGET=50
WORKER_POLL_SECONDS=15
MIN_SECONDS_BETWEEN_JOBS=20
MAX_RETRIES=3
SONG_DURATION_SECONDS=180

# YouTube OAuth files. Never commit these.
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/client_secret.json
YOUTUBE_TOKEN_FILE=./data/youtube-token.json
YOUTUBE_REDIRECT_URI=http://localhost:8000/oauth/callback
# Private for first test; change to public only after checking output.
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=10

DATABASE_PATH=./data/jobs.sqlite3
MEDIA_DIR=./media
HOST=127.0.0.1
PORT=8000
