# Required: Google AI Studio / Gemini API key with Lyria 3.5 access
GEMINI_API_KEY=

# Target and pacing
DAILY_TARGET=50
WORKER_POLL_SECONDS=20
MAX_RETRIES=3
MIN_SECONDS_BETWEEN_JOBS=30
DAILY_BUDGET_USD=10
ESTIMATED_LYRIA_COST_PER_SONG_USD=0.08

# YouTube OAuth client JSON file (never commit this file)
YOUTUBE_CLIENT_SECRETS_FILE=/app/secrets/client_secret.json
YOUTUBE_TOKEN_FILE=/app/data/youtube-token.json
YOUTUBE_REDIRECT_URI=http://localhost:8000/oauth/callback
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=10
YOUTUBE_NOTIFY_SUBSCRIBERS=false
YOUTUBE_DEFAULT_LANGUAGE=en
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=true

# Paths and API
DATABASE_PATH=/app/data/songflow.sqlite3
MEDIA_DIR=/app/media
HOST=0.0.0.0
PORT=8000
